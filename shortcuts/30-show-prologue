#!/bin/sh

cd "$HOME/Media/Orthodox_Hagiography/" || exit

alias date="date --date='-13 days'"
day="$(date +%e)"
month="$(date +%B)"
file="$(find . -name "* ${month} ${day## }.*.mkv")"

if [ -n "$file" ]; then
	termux-toast "Day $(date +%j)"
	termux-toast "${month} ${day}"
	xdg-open "$file"
else
	termux-toast "Today's Prologue was not found."
fi
